# Supabase Credentials (Shared across apps)
# Replace with your Supabase Project URL and Anon Public Key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (Admin operations only - Never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App URLs for local development
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_DELIVERY_URL=http://localhost:3002
