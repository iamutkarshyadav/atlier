{
  "name": "atelier-monorepo",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:seed": "pnpm --filter @repo/db db:seed",
    "simulate:e2e": "tsx scripts/simulate-e2e-flow.ts",
    "workers": "tsx scripts/run-workers.ts",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "next": "^14.2.15",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.18.0 <=24.x",
    "pnpm": ">=9.0.0"
  }
}
